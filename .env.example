# Copy to .env and adjust. All settings are optional.

# Spotify for Creators show id (the part after /pod/show/ in the dashboard URL).
# Needed only if your account manages more than one show.
# CTU_SPOTIFY_SHOW_ID=

# Run the Spotify browser without a window (login still opens a window when needed).
# CTU_SPOTIFY_HEADLESS=false

# Web UI address
# CTU_HOST=127.0.0.1
# CTU_PORT=8765
# CTU_OPEN_BROWSER=true

# Override tool locations (otherwise data/tools or PATH is used)
# CTU_FFMPEG_PATH=
# CTU_TWITCH_CLI_PATH=

# Where browser profile, temp files, logs and history live
# CTU_DATA_DIR=./data
